{
  "name": "Spainza Client Portal",
  "short_name": "Spainza",
  "description": "Secure client and staff portal for Spainza cases, documents, and messages.",
  "id": "/frontend/lk/",
  "start_url": "/frontend/lk/dashboard.html",
  "scope": "/frontend/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#ffffff",
  "theme_color": "#003ec7",
  "categories": ["business", "productivity"],
  "icons": [
    {
      "src": "/frontend/img/icon.png",
      "sizes": "609x609",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/frontend/img/app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/frontend/img/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Home",
      "url": "/frontend/lk/dashboard.html",
      "icons": [
        {
          "src": "/frontend/img/icon.png",
          "sizes": "609x609",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Documents",
      "short_name": "Docs",
      "url": "/frontend/lk/documents.html",
      "icons": [
        {
          "src": "/frontend/img/icon.png",
          "sizes": "609x609",
          "type": "image/png"
        }
      ]
    }
  ]
}
